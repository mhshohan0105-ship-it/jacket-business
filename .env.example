# .env ফাইলে আসল মান বসান। এই ফাইলে কখনো আসল মান লিখবেন না।
# দুটোই jacket_business database-এর হতে হবে, না হলে অ্যাপ চলবে না।

# Pooled URL (hostname-এ -pooler আছে)। অ্যাপ এটা দিয়ে চলে।
# দুটোই খালি থাকলে local-এ .data/pglite ফোল্ডারের database চলে।
DATABASE_URL=

# Direct URL (hostname-এ -pooler নেই)। শুধু migration-এ লাগে।
DATABASE_URL_UNPOOLED=

# অ্যাপে ঢোকার login। এ দুটো না দিলে কেউ ঢুকতে পারবে না।
APP_USERNAME=
APP_PASSWORD=
